# Karaoke Pipeline Container Configuration
# Copy this file to .env and fill in the values

# ===========================================
# Worker Identity (unique per node!)
# ===========================================
WORKER_ID=home-agent-windows

# ===========================================
# API Configuration
# ===========================================
VPS_API_BASE=https://n8n.1215group.com/webhook
WORKER_TOKEN=your_worker_token_here

# ===========================================
# Supabase
# ===========================================
SUPABASE_URL=https://wilpayvbjaimkrskwowb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ===========================================
# AWS S3 Storage
# ===========================================
AWS_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
AWS_S3_BUCKET=karaoke-pimpshizzle
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1

# ===========================================
# UI Configuration
# ===========================================
VITE_API_BASE=https://n8n.1215group.com/webhook
VITE_VIDEOS_BASE=https://karaoke.1215group.com/videos
KARAOKE_UI_PORT=8082

# ===========================================
# Agent Settings (optional)
# ===========================================
POLL_INTERVAL_SECONDS=30
HEARTBEAT_INTERVAL_SECONDS=60

# ===========================================
# Worker Capabilities
# ===========================================
# Set false for download-only nodes (no local GPU/Demucs)
STEM_SPLITTING_ENABLED=true
