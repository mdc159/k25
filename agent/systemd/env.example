# Karaoke Agent Environment Configuration
#
# SOURCE: Copy values from /mnt/x/GitHub/Hostinger/.env (master config)
# TARGET: /etc/karaoke-agent/env (on home agent machine)
#
# Quick setup:
#   grep -E '^(VPS_API_BASE|WORKER_TOKEN|SUPABASE_URL|SUPABASE_SERVICE_ROLE_KEY|AWS_|POLL_|DOWNLOAD_DIR|MAX_RETRIES)' /path/to/.env > /etc/karaoke-agent/env

# =============================================================================
# VPS API Configuration (n8n webhooks)
# =============================================================================
VPS_API_BASE=https://n8n.1215group.com/webhook
WORKER_TOKEN=

# =============================================================================
# Supabase Configuration
# =============================================================================
SUPABASE_URL=https://wilpayvbjaimkrskwowb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# AWS S3 Storage Configuration
# =============================================================================
AWS_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# =============================================================================
# Worker Settings
# =============================================================================
POLL_INTERVAL_SECONDS=30
DOWNLOAD_DIR=/var/lib/karaoke-agent/spool
MAX_RETRIES=3

# =============================================================================
# Optional Settings
# =============================================================================
# WORKER_ID=home-agent-1
# HEARTBEAT_INTERVAL_SECONDS=60
# LEASE_RENEWAL_INTERVAL_SECONDS=300
# LOG_FILE=/var/lib/karaoke-agent/karaoke-agent.log
# MAX_JOB_RETRIES=3
# REQUIRED_DISK_SPACE_GB=5.0
# CIRCUIT_BREAKER_THRESHOLD=5
# CIRCUIT_BREAKER_TIMEOUT=60
