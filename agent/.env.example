# Karaoke Agent Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# REQUIRED: VPS/n8n API Configuration
# =============================================================================
# Base URL for n8n webhook endpoints (no trailing slash)
VPS_API_BASE=https://n8n.1215group.com/webhook

# Worker authentication token (must match VPS n8n workflow expectations)
WORKER_TOKEN=your-worker-token-here

# =============================================================================
# REQUIRED: AWS S3 Configuration
# =============================================================================
AWS_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
AWS_S3_BUCKET=karaoke-pimpshizzle
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# =============================================================================
# REQUIRED: Supabase Configuration
# =============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# OPTIONAL: Worker Configuration (sensible defaults provided)
# =============================================================================
# Unique worker identifier (auto-generated if not set)
# WORKER_ID=home-pc-01

# Enable local GPU stem splitting (set to false to always use RunPod)
STEM_SPLITTING_ENABLED=true

# Demucs model for stem separation
# DEMUCS_MODEL=htdemucs_6s

# Poll interval in seconds (how often to check for new jobs)
# POLL_INTERVAL_SECONDS=30

# Heartbeat interval in seconds
# HEARTBEAT_INTERVAL_SECONDS=60
