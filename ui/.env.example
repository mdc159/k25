# Karaoke UI Environment Configuration
# Copy to .env.local or .env.production as needed

# API Base URL (n8n webhooks)
# - Development: Leave empty (uses Vite proxy from vite.config.ts)
# - Production: https://n8n.1215group.com/webhook
VITE_API_BASE=

# Videos Base URL (static assets served by nginx/CDN)
# - Development: Leave empty (uses Vite proxy)
# - Production: https://karaoke.1215group.com/videos
VITE_VIDEOS_BASE=
