# Production environment for Karaoke UI
# These values are embedded at build time

# n8n webhook base URL (no trailing slash)
VITE_API_BASE=https://n8n.1215group.com/webhook

# Videos CDN/static base URL (no trailing slash)
# Path must match S3 publish location: karaoke/pub/{slug}/
VITE_VIDEOS_BASE=https://karaoke.1215group.com/karaoke/pub
